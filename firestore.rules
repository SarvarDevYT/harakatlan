rules_version = '2';

// Only the game server (server/ on Vercel, with its admin key) touches the
// database. Phones and browsers go through the server, so nobody can edit
// their own km, tiles or clans directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
